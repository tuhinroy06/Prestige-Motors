<body>

  <!-- ========================================================
       1. NAVIGATION BAR (HTML5 <header> & <nav> semantic elements)
       ======================================================== -->
  <header class="site-header" id="siteHeader">
    <div class="header-container">
      <!-- Showroom Logo & Brand Mark -->
      <a href="#hero" class="brand-logo" aria-label="Prestige Motors Homepage">
        <span class="logo-crest">⚜</span>
        <div class="logo-text">
          <span class="brand-name">PRESTIGE</span>
          <span class="brand-sub">MOTORS</span>
        </div>
      </a>

      <!-- Desktop & Mobile Navigation Menu -->
      <nav class="nav-menu" id="navMenu" aria-label="Main Navigation">
        <ul class="nav-links">
          <li><a href="#hero" class="nav-link active">Home</a></li>
          <li><a href="#collection" class="nav-link">Our Cars</a></li>
          <li><a href="#comparison" class="nav-link">Specifications</a></li>
          <li><a href="#about" class="nav-link">About Us</a></li>
          <li><a href="#why-choose-us" class="nav-link">Why Choose Us</a></li>
          <li><a href="#gallery" class="nav-link">Gallery</a></li>
          <li><a href="#contact" class="nav-link">Contact</a></li>
        </ul>
      </nav>

      <!-- Navigation Actions (Favorites Button + Mobile Toggle) -->
      <div class="nav-actions">
        <!-- LocalStorage Favorites Trigger Button -->
        <button type="button" class="btn-favorites" id="favoritesBtn" aria-label="View Saved Favorite Cars">
