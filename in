                loading="lazy" 
                referrerpolicy="no-referrer-when-downgrade">
              </iframe>
            </div>
          </div>

          <!-- Right Column: Interactive Contact Form with Validation -->
          <div class="contact-form-panel">
            <h3 class="panel-title">Request VIP Consultation</h3>
            
            <!-- Live Success / Error Banner -->
            <div id="formAlert" class="form-alert" style="display: none;" role="alert"></div>

            <form id="contactForm" novalidate>
              <!-- Full Name Field -->
              <div class="form-group">
                <label for="fullName">Full Name <span class="required">*</span></label>
                <input type="text" id="fullName" name="fullName" placeholder="e.g. Alexander Sterling" autocomplete="name">
                <span class="error-msg" id="nameError"></span>
              </div>

              <!-- Two Column Row: Email & Phone -->
              <div class="form-row">
                <div class="form-group">
                  <label for="email">Email Address <span class="required">*</span></label>
                  <input type="email" id="email" name="email" placeholder="alexander@example.com" autocomplete="email">
                  <span class="error-msg" id="emailError"></span>
                </div>
                <div class="form-group">
                  <label for="phone">Phone Number <span class="required">*</span></label>
                  <input type="tel" id="phone" name="phone" placeholder="+1 (555) 000-0000" autocomplete="tel">
                  <span class="error-msg" id="phoneError"></span>
                </div>
              </div>

              <!-- Vehicle of Interest Dropdown (<select>) -->
              <div class="form-group">
                <label for="vehicleSelect">Vehicle of Interest</label>
                <select id="vehicleSelect" name="vehicleSelect">
                  <option value="General Inquiry">Select a vehicle model (Optional)</option>
                  <option value="Rolls-Royce Ghost">Rolls-Royce Ghost ($395,000)</option>
                  <option value="Bentley Continental GT">Bentley Continental GT ($302,000)</option>
                  <option value="Porsche 911 Turbo S">Porsche 911 Turbo S ($230,000)</option>
                  <option value="Mercedes-Maybach S 680">Mercedes-Maybach S 680 ($229,000)</option>
                  <option value="Aston Martin DB12">Aston Martin DB12 ($245,000)</option>
                  <option value="Ferrari Roma Spider">Ferrari Roma Spider ($275,000)</option>
                </select>
              </div>

              <!-- Consultation Type Radios -->
              <div class="form-group">
                <label class="group-label">Preferred Appointment Type</label>
                <div class="radio-group">
                  <label class="radio-label">
                    <input type="radio" name="inquiryType" value="Private Showroom Tour" checked>
                    <span>Private Showroom Tour</span>
                  </label>
                  <label class="radio-label">
                    <input type="radio" name="inquiryType" value="Track Test Drive">
                    <span>Track Test Drive</span>
                  </label>
                  <label class="radio-label">
                    <input type="radio" name="inquiryType" value="Bespoke Financing Inquiry">
                    <span>Bespoke Financing Inquiry</span>
                  </label>
                </div>
              </div>

              <!-- Message Field (<textarea>) -->
              <div class="form-group">
                <label for="message">Message / Specific Requests <span class="required">*</span></label>
                <textarea id="message" name="message" rows="4" placeholder="Tell us about your preferred specifications, timeline, or consultation date..."></textarea>
                <span class="error-msg" id="messageError"></span>
              </div>

              <!-- Opt-in Checkbox -->
              <div class="form-group checkbox-group">
                <label class="checkbox-label">
                  <input type="checkbox" id="newsletterCheck" name="newsletterCheck" checked>
                  <span>Receive discreet private invitations to upcoming vehicle reveals.</span>
                </label>
              </div>

              <!-- Submit Button -->
              <button type="submit" class="btn btn-primary btn-block" id="submitBtn">
                <span class="btn-text">Submit VIP Request</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>

