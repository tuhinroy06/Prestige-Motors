      <div class="container">
        <div class="section-header">
          <span class="section-badge">SENSORY EXCELLENCE</span>
          <h2 class="section-title">The Sound of Pure Performance</h2>
          <div class="gold-divider"></div>
          <p class="section-subtitle">
            Immerse yourself in the thunderous symphony of precision-engineered multi-cylinder automotive craftsmanship.
          </p>
        </div>

        <div class="experience-grid">
          <!-- HTML5 Audio Demonstration Box -->
          <article class="experience-card audio-card">
            <div class="card-icon">🔊</div>
            <h3 class="card-title">V12 Twin-Turbo Exhaust Note</h3>
            <p class="card-desc">
              Listen to the acoustic masterpiece produced by handcrafted titanium exhaust systems and high-revving quad camshafts.
            </p>
            <!-- HTML5 <audio> Element with native controls -->
            <div class="audio-player-wrapper">
              <audio id="engineAudio" controls preload="metadata">
                <source src="assets/engine-sound.mp3" type="audio/mpeg">
                <source src="assets/engine-sound.wav" type="audio/wav">
                Your browser does not support the audio element.
              </audio>
            </div>
            <span class="audio-tip">Tip: Use headphones for the ultimate acoustic rumble.</span>
          </article>

          <!-- HTML5 <video> Showcase Box -->
