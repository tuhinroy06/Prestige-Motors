            <div class="card-icon">🎬</div>
            <h3 class="card-title">Showroom Virtual Showcase</h3>
            <p class="card-desc">
              Experience the elegance of our Beverly Hills showroom floor where lighting and architecture highlight every sculpted curve.
            </p>
            <!-- HTML5 <video> Element with poster and controls -->
            <figure class="video-container">
              <video id="showroomVideo" controls poster="https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=800&q=80">
                <source src="assets/showroom-showcase.mp4" type="video/mp4">
