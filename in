  <!-- ========================================================
       MAIN CONTENT CONTAINER (HTML5 <main> element)
       ======================================================== -->
  <main id="mainContent">

    <!-- ======================================================
         2. HERO SECTION
         ====================================================== -->
    <section class="hero-section" id="hero">
      <div class="hero-overlay"></div>
      <div class="hero-content container">
        <span class="hero-subtitle">THE PINNACLE OF AUTOMOTIVE LUXURY</span>
        <h1 class="hero-title">Discover Your Dream Car</h1>
        <p class="hero-description">
          Welcome to Prestige Motors, where automotive passion meets timeless perfection. 
          Explore an exceptional selection of curated exotics, master-crafted grand tourers, 
          and peerless luxury motorcars built for discerning connoisseurs.
        </p>
        <div class="hero-cta-group">
          <a href="#collection" class="btn btn-primary">Explore Cars</a>
          <a href="#contact" class="btn btn-outline">Schedule VIP Consultation</a>
        </div>

        <!-- Quick Metrics Highlights -->
        <div class="hero-highlights">
          <div class="highlight-item">
            <span class="highlight-number">100%</span>
            <span class="highlight-label">Certified Heritage</span>
          </div>
          <div class="highlight-divider"></div>
          <div class="highlight-item">
            <span class="highlight-number">500+</span>
            <span class="highlight-label">Exotic Vehicles Delivered</span>
          </div>
          <div class="highlight-divider"></div>
          <div class="highlight-item">
            <span class="highlight-number">25+</span>
            <span class="highlight-label">Years of Excellence</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ======================================================
         3. OUR COLLECTION SECTION
         ====================================================== -->
    <section class="section collection-section" id="collection">
      <div class="container">
        <!-- Section Header -->
        <div class="section-header">
          <span class="section-badge">EXQUISITE FLEET</span>
          <h2 class="section-title">Our Exclusive Collection</h2>
          <div class="gold-divider"></div>
          <p class="section-subtitle">
            Every vehicle in our showroom undergoes rigorous multi-point validation to guarantee pristine aesthetic and mechanical excellence.
          </p>
        </div>

        <!-- Collection Filter & Search Controls -->
        <div class="collection-controls">
          <div class="filter-buttons" id="filterButtons" role="group" aria-label="Filter Cars by Category">
            <button type="button" class="filter-btn active" data-category="all">All Vehicles</button>
            <button type="button" class="filter-btn" data-category="supercar">Supercars</button>
            <button type="button" class="filter-btn" data-category="grand-tourer">Grand Tourers</button>
            <button type="button" class="filter-btn" data-category="sedan">Ultra-Luxury Sedans</button>
          </div>

          <div class="search-box">
            <input type="text" id="carSearchInput" placeholder="Search by model, make, or specs..." aria-label="Search Collection">
            <span class="search-icon">🔍</span>
          </div>
        </div>

        <!-- Dynamic Car Grid (Rendered by script.js) -->
        <div class="car-grid" id="carGrid">
          <!-- Fallback noscript content if JavaScript is disabled -->
          <noscript>
            <div class="noscript-message">
              <p>Please enable JavaScript to view the interactive car collection, live search, and favorites feature.</p>
            </div>
          </noscript>
        </div>

        <!-- Empty search state container (hidden by default) -->
        <div class="empty-state" id="emptyState" style="display: none;">
          <p>No luxury vehicles matched your search query. Please try another keyword or filter.</p>
          <button type="button" class="btn btn-outline" id="resetFiltersBtn">Reset All Filters</button>
        </div>
      </div>
    </section>

    <!-- ======================================================
         EXPERIENCE / ENGINE ACOUSTICS & VIDEO (HTML5 Audio/Video)
         ====================================================== -->
