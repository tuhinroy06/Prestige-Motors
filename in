                <td>2.6 sec</td>
                <td>205 mph</td>
                <td>8-Speed Porsche Doppelkupplung</td>
                <td class="table-price">$230,000</td>
                <td>4-Year / 50k Miles</td>
              </tr>
              <tr>
                <th scope="row">Mercedes-Maybach S 680</th>
                <td>6.0L Biturbo V12</td>
                <td>621 hp</td>
                <td>4.4 sec</td>
                <td>155 mph</td>
                <td>9G-TRONIC Automatic</td>
                <td class="table-price">$229,000</td>
                <td>4-Year / 50k Miles</td>
              </tr>
              <tr>
                <th scope="row">Aston Martin DB12</th>
                <td>4.0L Twin-Turbo V8</td>
                <td>671 hp</td>
                <td>3.5 sec</td>
                <td>202 mph</td>
                <td>8-Speed Automatic</td>
